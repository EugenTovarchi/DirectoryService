{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "24eye.auth",
    "Audience": "24eye.backend",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 25,
    "EnableSsl": false,
    "FromEmail": "no-reply@24eye.local",
    "FromName": "24Eye",
    "InviteBaseUrl": "http://localhost:3000/24eye/invite",
    "PasswordResetBaseUrl": "http://localhost:3000/24eye/reset-password"
  },
  "ServiceClients": {
    "Clients": []
  },
  "PublicAuthRateLimits": {
    "_comment": "Fixed-window (фиксированное временное окно) per-IP лимиты для public auth endpoints. Блокировка входа в аккаунт настраивается отдельно в Identity.",
    "Enabled": true,
    "WindowSeconds": 60,
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "PasswordResetPermitLimit": 3,
    "InviteResendPermitLimit": 10
  },
  "AllowedHosts": "*"
}
