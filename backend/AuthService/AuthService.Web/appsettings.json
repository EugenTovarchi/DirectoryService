{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "24eye.auth",
    "Audience": "24eye.backend",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Oidc": {
    "_comment": "OAuth 2.0/OpenID Connect server. Production certificates are supplied through secrets or mounted files.",
    "Enabled": false,
    "DisableTransportSecurityRequirement": false,
    "Issuer": "https://localhost:5001/",
    "UseDevelopmentCertificates": false,
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
    "EncryptionCertificatePath": "",
    "EncryptionCertificatePassword": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "Clients": []
  },
  "Email": {
    "Enabled": false,
    "SmtpHost": "",
    "SmtpPort": 25,
    "EnableSsl": false,
    "FromEmail": "no-reply@24eye.local",
    "FromName": "24Eye",
    "InviteBaseUrl": "http://localhost:3000/24eye/invite",
    "PasswordResetBaseUrl": "http://localhost:3000/24eye/reset-password"
  },
  "EmailOutbox": {
    "_comment": "Quartz регулярно ищет готовые письма. Retry хранится в PostgreSQL, поэтому переживает перезапуск AuthService.",
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "MessagesPerRun": 10,
    "MaxAttempts": 5,
    "InitialRetryDelaySeconds": 30,
    "MaxRetryDelaySeconds": 900,
    "ProcessingLeaseSeconds": 120
  },
  "LocalUsersSeed": {
    "_comment": "Opt-in local users for Development/Docker only. Supply Email and Password through runtime configuration; never commit real credentials.",
    "Enabled": false,
    "Password": "",
    "Users": []
  },
  "ServiceClients": {
    "Clients": []
  },
  "PublicAuthRateLimits": {
    "_comment": "Fixed-window (фиксированное временное окно) per-IP лимиты для public auth endpoints. Блокировка входа в аккаунт настраивается отдельно в Identity.",
    "Enabled": true,
    "WindowSeconds": 60,
    "LoginPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "PasswordResetPermitLimit": 3,
    "InviteResendPermitLimit": 10
  },
  "AllowedHosts": "*"
}
