{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp: HH:mm:ss.ff}{Level:3}] {SourceContext: l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Oidc": {
    "Enabled": true,
    "DisableTransportSecurityRequirement": true,
    "Issuer": "https://localhost:5001/",
    "UseDevelopmentCertificates": true,
    "Clients": [
      {
        "_comment": "Public Postman client: secret не нужен, безопасность code exchange обеспечивает PKCE.",
        "ClientId": "postman",
        "DisplayName": "Postman Docker development",
        "ClientSecret": "",
        "RedirectUris": [
          "https://oauth.pstmn.io/v1/callback"
        ],
        "AllowedScopes": [
          "openid",
          "profile",
          "email",
          "offline_access",
          "directory",
          "files",
          "auth"
        ]
      }
    ]
  },
  "Email": {
    "Enabled": true,
    "SmtpHost": "mailpit",
    "SmtpPort": 1025,
    "EnableSsl": false,
    "FromEmail": "no-reply@24eye.local",
    "FromName": "24Eye",
    "InviteBaseUrl": "http://localhost:3000/24eye/invite",
    "PasswordResetBaseUrl": "http://localhost:3000/24eye/reset-password"
  },
  "LocalUsersSeed": {
    "_comment": "Development-only accounts for checking every role. Password is supplied only by LocalUsersSeed__Password in runtime environment.",
    "Enabled": false,
    "Password": "",
    "Users": [
      {
        "Email": "system-admin@24eye.local",
        "DisplayName": "Local System Admin",
        "Role": "SystemAdmin",
        "CurrentCompanyId": null
      },
      {
        "Email": "company-admin@24eye.local",
        "DisplayName": "Local Company Admin",
        "Role": "CompanyAdmin",
        "CurrentCompanyId": "11111111-1111-1111-1111-111111111111"
      },
      {
        "Email": "operator@24eye.local",
        "DisplayName": "Local Operator",
        "Role": "Operator",
        "CurrentCompanyId": "11111111-1111-1111-1111-111111111111"
      },
      {
        "Email": "technician@24eye.local",
        "DisplayName": "Local Technician",
        "Role": "Technician",
        "CurrentCompanyId": "11111111-1111-1111-1111-111111111111"
      },
      {
        "Email": "viewer-readonly@24eye.local",
        "DisplayName": "Local Viewer",
        "Role": "Viewer",
        "CurrentCompanyId": "11111111-1111-1111-1111-111111111111"
      }
    ]
  },
  "ServiceClients": {
    "Clients": []
  },
  "Logging": {
    "Loki": {
      "Url": "http://loki:3100"
    }
  },
  "AllowedHosts": "*"
}
