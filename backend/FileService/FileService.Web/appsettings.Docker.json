{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Error",
        "Microsoft.EntityFrameworkCore.Database.Transaction": "Error",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Error",
        "Microsoft.EntityFrameworkCore.Update": "Error",
        "Microsoft.EntityFrameworkCore.Query": "Warning",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "Microsoft.EntityFrameworkCore.Model": "Warning",
        "Microsoft.EntityFrameworkCore.Model.Validation": "Warning",
        "Amazon": "Warning",
        "AWSSDK": "Warning",
        "Quartz": "Warning",
        "Wolverine": "Warning",
        "Wolverine.Configuration.HandlerDiscovery": "Error",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp: HH:mm:ss.ff}{Level:3}] {SourceContext: l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "redis:6379",
    "RabbitMq": ""
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:50051",
        "Protocols": "Http2"
      }
    }
  },
  "S3Options": {
    "ForcePathStyle": true,
    "WithSsl": false,
    "RequiredBuckets": [
      "file-service-videos",
      "file-service-pictures",
      "file-service-documents",
      "file-service-preview"
    ],
    "UploadUrlExpirationMinutes": 10,
    "UploadUrlExpirationHours": 1,
    "DownloadUrlExpirationDays": 5,
    "MaxConcurrentRequests": 100,
    "MaxChunks": 100
  },
  "CacheOptions": {
    "EnableCaching": true
  },
  "VideoProcessingOptions": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "UseHardwareAcceleration": false,
    "VideoEncoder": "libx264",
    "VideoPreset": "medium",
    "UploadDegreeOfParallelism": 3,
    "MaxRetries": 3,
    "RetryDelaySeconds": 60,
    "MaxConcurrentJobs": 2,
    "UsePersistentStore": true,
    "QuartzTablePrefix": "quartz.qrtz_",
    "UseQuartzClustering": true,
    "ClusterCheckinIntervalSeconds": 10,
    "ClusterCheckinMisfireThresholdSeconds": 20,
    "RecoveryScanIntervalSeconds": 60,
    "EnableRecoveryService": true,
    "EnableTempCleanupJob": true,
    "TempDirectoryMaxAgeHours": 24,
    "TempCleanupIntervalMinutes": 60
  },
  "PreviewOptions": {
    "Quality": 2,
    "FrameWidth": 320,
    "FrameHeight": 180,
    "FileNamePattern": "preview_{index}.jpg",
    "SpriteSheetFileName": "sprite_sheet.jpg",
    "MaxPreviewCount": 10,
    "MinPreviewCount": 3,
    "SecondsPerPreview": 30
  },
  "Logging": {
    "Loki": {
      "Url": "http://loki:3100"
    }
  },

  "AllowedHosts": "*"
}
