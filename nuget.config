<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="gitlab-sharedservice" value="https://gitlab.com/api/v4/projects/84125570/packages/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="gitlab-sharedservice">
      <package pattern="IstredDev.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
